# Ядро
DATABASE_URL=postgresql+asyncpg://gamestore:gamestore@127.0.0.1:5432/gamestore_core
SUPPLIER_DATABASE_URL=postgresql+asyncpg://gamestore:gamestore@127.0.0.1:5432/gamestore_suppliers
LOG_LEVEL=INFO
LOG_JSON=1

# Поставщики-заглушки
SUPPLIER_A_URL=http://127.0.0.1:9101
SUPPLIER_B_URL=http://127.0.0.1:9102
SUPPLIER_CONNECT_TIMEOUT=1.0
SUPPLIER_READ_TIMEOUT=2.0
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE=0.2

# Воркер
WORKER_ENABLED=1
WORKER_CONCURRENCY=8
STUCK_ORDER_SECONDS=30
SWEEPER_INTERVAL=5.0
DELIVERY_MAX_ATTEMPTS=10
